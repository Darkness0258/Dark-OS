new file mode 100644
index 0000000..1241b20
--- /dev/null
+++ b/airootfs/etc/aide.conf
@@ -0,0 +1,47 @@
+# DarkOS AIDE config — file integrity baseline for build-plan.md's Shield
+# "system integrity baselines" item.
+#
+# Verified against the real aide binary (0.18.6) in a sandbox before
+# writing this for real: --init/--check both confirmed to actually work
+# with this syntax, a real modified file is genuinely detected (exit code
+# goes non-zero, a real diff with old/new SHA256 and mtime shows up), and
+# a change inside an excluded path is correctly ignored. Not verified
+# against Arch's own aide build specifically, or against DarkOS's real
+# installed filesystem layout — same category of gap as everywhere else
+# in this project that needed real hardware to close out.
+
+database_in=file:/var/lib/aide/aide.db
+database_out=file:/var/lib/aide/aide.db.new
+
+# p=permissions i=inode n=link count u=owner g=group s=size m=mtime
+# c=ctime sha256=content hash. No md5 -- sha256 alone is enough and one
+# hash is cheaper to compute than several for no real benefit here.
+NORMAL = p+i+n+u+g+s+m+c+sha256
+
+# System paths worth a tamper-evidence baseline: binaries, libraries,
+# configuration, boot files. Not /usr/sbin separately -- on Arch it's a
+# symlink into /usr/bin, and AIDE follows the rule tree from /usr anyway.
+/usr/bin NORMAL
+/usr/lib NORMAL
+/etc NORMAL
+/boot NORMAL
+
+# Excluded: paths that legitimately change during normal, non-malicious
+# use. Monitoring these would mean a check that "finds something" every
+# single run, which trains a user to ignore the alert entirely -- worse
+# than not checking at all.
+!/etc/machine-id
+!/etc/resolv.conf
+!/etc/mtab
+!/etc/adjtime
+!/etc/NetworkManager
+!/var/log
+!/var/cache
+!/var/lib/pacman
+!/var/lib/darkos
+!/tmp
+!/home
+!/proc
+!/sys
+!/dev
+!/run
