{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "backlight",
        "custom/bluetooth",
        "network",
        "pulseaudio",
        "battery",
        "custom/control",
        "custom/avatar",
        "custom/power"
    ],

    "custom/logo": {
        "format": "❖ DARK OS",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },
    "hyprland/window": {
        "format": "<b>{title}</b>",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": {
            "": "DarkOS Desktop"
        }
    },
    "clock": {
        "format": "󰥔 {:%a, %b %d  %I:%M %p}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "backlight": {
        "format": "󰃠 {percent}%",
        "tooltip": false
    },
    "custom/bluetooth": {
        "exec": "timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && printf '󰂯 On' || printf '󰂲 Off'",
        "interval": 5,
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 Online",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi": "{essid} ({ipaddr})",
        "tooltip-format-ethernet": "{ifname} ({ipaddr})"
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "Muted",
        "scroll-step": 5,
        "on-click": "pamixer -t"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "custom/control": {
        "format": " ",
        "tooltip-text": "Control Center",
        "on-click": "python /usr/local/bin/darkos-shell.py --toggle-control"
    },
    "custom/avatar": {
        "format": "󰀉 darkos",
        "tooltip-text": "Account controls remain part of the future Settings app"
    },
    "custom/power": {
        "format": " ",
        "tooltip-text": "Power menu",
        "on-click": "wlogout || systemctl poweroff"
    }
}
