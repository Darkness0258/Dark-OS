{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "network",
        "pulseaudio",
        "battery",
        "custom/control",
        "custom/avatar",
        "custom/power"
    ],

    "custom/logo": {
        "format": "❖ DARK OS",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },
    "hyprland/window": {
        "format": "<b>{title}</b>",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": {
            "": "DarkOS Desktop"
        }
    },
    "clock": {
        "format": "󰥔 {:%a, %b %d  %I:%M %p}",
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": true
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 3,
        "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB"
    },
    "disk": {
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "interval": 10,
        "tooltip-format": "Disk Used: {used} / {total}"
    },
    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 Online",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi": "{essid} ({ipaddr})",
        "tooltip-format-ethernet": "{ifname} ({ipaddr})"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pamixer -t"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "custom/control": {
        "format": "󰒓",
        "tooltip-text": "Control Center",
        "on-click": "python /usr/local/bin/darkos-shell.py --toggle-control"
    },
    "custom/avatar": {
        "format": "󰀉 darkos",
        "tooltip": false
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout || systemctl poweroff"
    }
}
