{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,
    "modules-left": [
        "image#logo",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/bluetooth",
        "network",
        "pulseaudio",
        "battery",
        "custom/control",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "": "DarkOS"
        }
    },
    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "interval": 30,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/bluetooth": {
        "exec": "timeout 2 bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo '󰂯' || echo '󰂲'",
        "interval": 10,
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({ipaddr})",
        "tooltip-format-ethernet": "{ifname} ({ipaddr})"
    },
    "pulseaudio": {
        "format": "",
        "format-muted": "",
        "scroll-step": 5,
        "on-click": "pamixer -t"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "custom/control": {
        "format": " ",
        "on-click": "python /usr/local/bin/darkos-shell.py --toggle-control",
        "tooltip-format": "Command Center"
    },
    "custom/power": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip-format": "Power menu"
    },
    "image#logo": {
        "path": "/usr/share/icons/darkos/darkos.png",
        "size": 20,
        "tooltip": false
    }
}
