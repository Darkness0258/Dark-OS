# DarkOS notifications (mako). GENERATED by tools/gen-theme.py from the Calm
# Dark palette: edit the palette or the generator, not this file.
# A solid card: no blur or shadow, so it stays cheap on software rendering.
font=Inter 12
background-color=#283039f2
text-color=#eff2f6
border-color=#eff2f633
border-size=1
border-radius=16
padding=12
margin=12
width=360
default-timeout=6000
max-visible=4
# The Command Center lists recent notifications from mako's history.
max-history=20
anchor=top-right
layer=overlay

[urgency=high]
border-color=#ff716bcc
default-timeout=0

# Focus mode (Command Center > Focus): hide popups. Notifications are kept
# and can be read when Focus is switched off.
[mode=do-not-disturb]
invisible=1
