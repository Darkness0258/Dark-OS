[Unit]
Description=DarkOS: install GRUB bootloader and generate config
After=local-fs.target
Before=multi-user.target
# Run on first boot regardless of whether grub.cfg exists (the in-install
# bootloader step can fail silently, and a broken-but-present grub.cfg is
# exactly the case that must be repaired). Only skip once a real,
# menu-entry-containing config has been verified by the wrapper, which
# writes this marker only on success.
ConditionPathExists=!/var/lib/darkos-grub-repair.done
# Never run on the LIVE ISO — it already ships an initramfs and doesn't
# need GRUB installed. Without this, mkinitcpio -P runs on every live
# boot (the marker doesn't exist there either), looking like a hang.
ConditionPathExists=!/run/archiso

[Service]
Type=oneshot
# ExecStartPre does NOT run through a shell: a bare `|| true` gets passed
# to chmod as literal filenames ("chmod: cannot access '||'"). Wrap the
# shell logic explicitly in sh -c.
ExecStartPre=/bin/sh -c 'chmod +x /usr/local/bin/darkos-grub-install.sh || true'
# The wrapper does the whole job in one fixed order: ensure a standard
# mkinitcpio preset, drop the live-ISO archiso drop-in, build the
# initramfs (mkinitcpio -P), install GRUB (--removable), regenerate
# grub.cfg, and write the completion marker only when bootable.
ExecStart=/bin/sh -c 'exec /usr/local/bin/darkos-grub-install.sh'

[Install]
WantedBy=multi-user.target
