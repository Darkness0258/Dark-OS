[Unit]
Description=DarkOS: install GRUB bootloader and generate config
After=local-fs.target
Before=multi-user.target
# Run on first boot regardless of whether grub.cfg exists (the in-install
# bootloader step can fail silently, and a broken-but-present grub.cfg is
# exactly the case that must be repaired). Only skip once a real,
# menu-entry-containing config has been verified by the wrapper, which
# writes this marker only on success.
ConditionPathExists=!/var/lib/darkos-grub-repair.done

[Service]
Type=oneshot
# The wrapper can lose its exec bit between squashfs build and install
# (mode delivery gap). Re-assert it explicitly, then run via `sh` so a
# missing exec bit can't block the install.
ExecStartPre=/bin/chmod +x /usr/local/bin/darkos-grub-install.sh || true
ExecStartPre=/usr/bin/mkinitcpio -P
# The wrapper finds + mounts the ESP itself, installs GRUB with
# --removable, and generates grub.cfg if missing.
ExecStart=/bin/sh -c 'exec /usr/local/bin/darkos-grub-install.sh'

[Install]
WantedBy=multi-user.target
