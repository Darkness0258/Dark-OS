#!/bin/bash
# DarkOS Hyprland session launcher.
#
# Both the live ISO and installed system call this wrapper so DarkOS can set
# its session environment in one place. Current Hyprland packages also ship
# /usr/bin/start-hyprland; delegate to it when available so upstream startup
# checks and environment preparation remain in effect.
#
# Keeping this as a wrapper (rather than inlining `Hyprland` into the
# .bash_profile files) means the session env vars live in one place and
# any future session setup (e.g. a display manager) can reuse it.

set -euo pipefail

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
# Suppress Python SyntaxWarnings from Calamares (invalid escape sequences
# in /usr/lib/calamares/modules/bootloader/main.py). Also set in
# hyprland.conf as env = PYTHONWARNINGS.
export PYTHONWARNINGS=ignore::SyntaxWarning

# Load private user environment securely if present (e.g. installer API keys)
if [[ -n "${HOME:-}" && -f "${HOME}/.config/darkos/env" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        if [[ "$line" =~ ^(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            var_name="${BASH_REMATCH[2]}"
            var_val="${BASH_REMATCH[3]}"
            if [[ "$var_val" =~ ^\'(.*)\'$ ]] || [[ "$var_val" =~ ^\"(.*)\"$ ]]; then
                var_val="${BASH_REMATCH[1]}"
            fi
            export "${var_name}=${var_val}"
        fi
    done < "${HOME}/.config/darkos/env"
fi

# Virtual / software rendering detection:
# Under VMware, VirtualBox, or QEMU without 3D acceleration, Mesa DRI
# fails on vmwgfx/virtio unless llvmpipe software rasterizer is enabled.
is_vm=0
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
    is_vm=1
elif [[ -f /sys/class/dmi/id/sys_vendor ]] && grep -qiE 'vmware|virtualbox|qemu|kvm' /sys/class/dmi/id/sys_vendor 2>/dev/null; then
    is_vm=1
fi

if [[ "$is_vm" == "1" ]]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
    export WLR_NO_HARDWARE_CURSORS=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export AQ_NO_MODIFIERS=1
fi

# Rendering backend isn't the whole story: Hyprland's own compositor cost
# (multi-pass blur, shadows, animations) doesn't shrink just because
# rendering moved to software -- that GPU work still has to happen
# somewhere, and on llvmpipe it's what actually makes a VM session
# "unusable" rather than just "not accelerated". hyprland.conf sources
# this file after its own decoration{}/animations{} blocks so these
# colon-path overrides win without duplicating those blocks; it's
# regenerated every session so it always matches this session's real
# detection result rather than a stale one from a previous boot.
perf_conf_dir="${HOME:-/root}/.config/hypr/conf.d"
mkdir -p "$perf_conf_dir" 2>/dev/null || true
perf_conf="$perf_conf_dir/perf-auto.conf"
if [[ "$is_vm" == "1" ]]; then
    cat > "$perf_conf" <<'PERFEOF'
# Auto-generated by start-hyprland every session -- do not hand-edit,
# it will be overwritten. Virtualization was detected this session.
decoration:blur:enabled = false
decoration:shadow:enabled = false
animations:enabled = false
PERFEOF
else
    # Bare metal: no override needed, base hyprland.conf's own values
    # apply. Empty file keeps the `source =` line below always valid
    # without needing a conditional in hyprland.conf itself.
    : > "$perf_conf"
fi

if [[ -x /usr/bin/start-hyprland ]]; then
    exec /usr/bin/start-hyprland "$@"
fi

exec /usr/bin/Hyprland "$@"
