#!/bin/bash
# choose-mirror -- the old entry point, kept so scripts and habits still work.
# It used to pipe reflector straight into /etc/pacman.d/mirrorlist with the errors
# thrown away. The real work is darkos-mirrors.py, which validates the result,
# backs up the current list, and leaves it untouched on any failure.
# Usage: choose-mirror [--country DE,FR] [--number 10]   (run as root)
exec /usr/local/bin/darkos-mirrors.py rank "$@"
