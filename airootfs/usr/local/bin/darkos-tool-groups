#!/bin/bash
# DarkOS BlackArch tool-group picker.
#
# BlackArch packages are grouped (e.g. blackarch-scanner, blackarch-webapp,
# blackarch-cracker, ...). This script lists the available groups and
# installs the ones the user selects. Run it as root on the installed
# system (or from the live ISO).
#
# Usage:
#   darkos-tool-groups                # interactive picker
#   darkos-tool-groups list           # list all groups
#   darkos-tool-groups install <grp> [<grp> ...]   # install specific groups

set -euo pipefail

GROUP_PREFIX="blackarch-"

die() {
    echo "darkos-tool-groups: $*" >&2
    exit 1
}

ensure_sync_db() {
    if [ ! -d /var/lib/pacman/sync/blackarch ] || [ -z "$(ls -A /var/lib/pacman/sync/blackarch 2>/dev/null)" ]; then
        echo "Syncing pacman databases..." >&2
        pacman -Sy --noconfirm 2>/dev/null || true
    fi
}

available_groups() {
    ensure_sync_db
    pacman -Sg 2>/dev/null \
        | awk '$1 ~ /^blackarch-/ { sub(/^blackarch-/, "", $1); print $1 }' \
        | sort -u
}

normalize_group() {
    local group="$1"
    printf '%s\n' "${group#${GROUP_PREFIX}}"
}

group_exists() {
    local wanted="$1"
    available_groups \
        | awk -v wanted="$wanted" '$0 == wanted { found=1 } END { exit !found }'
}

install_groups() {
    [ "$EUID" -eq 0 ] || die "installation requires root (run with sudo)"

    local input group
    local -a targets=()
    for input in "$@"; do
        group="$(normalize_group "$input")"
        case "$group" in
            all)
                targets=(blackarch)
                break
                ;;
            ''|*[!a-zA-Z0-9._+-]*)
                die "invalid group name: $input"
                ;;
        esac
        group_exists "$group" || die "unknown BlackArch group: $input"
        targets+=("${GROUP_PREFIX}${group}")
    done

    [ "${#targets[@]}" -gt 0 ] || die "no groups were selected"
    pacman -S --needed --noconfirm "${targets[@]}"
}

interactive_pick() {
    local groups
    local -a selection=()
    groups="$(available_groups)"
    
    if [ -z "$groups" ]; then
        echo "Updating BlackArch database..." >&2
        pacman -Sy --noconfirm || true
        groups="$(available_groups)"
    fi
    
    if [ -z "$groups" ]; then
        die "no BlackArch groups found; verify repository configuration in /etc/pacman.conf"
    fi

    # Check if stdout/stdin is interactive TTY
    if [ -t 0 ] && [ -t 1 ]; then
        echo "Select BlackArch tool groups to install (space-separated, or 'all')."
        echo "WARNING: 'all' installs the entire BlackArch repo (~2900 packages)."
        echo ""
        echo "$groups"
        echo ""
        if ! read -rp "> " -a selection; then
            selection=()
        fi
    elif command -v wofi >/dev/null 2>&1; then
        local chosen
        chosen=$(printf "all\n%s" "$groups" | wofi --dmenu --prompt "Select BlackArch Tool Group:")
        if [ -n "$chosen" ]; then
            selection=("$chosen")
        fi
    fi

    if [ "${#selection[@]}" -eq 0 ]; then
        echo "Nothing selected — exiting." >&2
        exit 0
    fi

    if printf '%s\n' "${selection[@]}" | grep -Fqx all; then
        echo "Installing entire BlackArch repo — this is a very large download." >&2
    fi
    install_groups "${selection[@]}"
}

case "${1:-}" in
    list)
        groups="$(available_groups)"
        [ -n "$groups" ] || die "no BlackArch groups found; run 'pacman -Sy'"
        printf '%s\n' "Available BlackArch tool groups:" "$groups"
        ;;
    install)
        shift
        if [ "$#" -eq 0 ]; then
            echo "usage: darkos-tool-groups install <group> [<group> ...]" >&2
            exit 1
        fi
        install_groups "$@"
        ;;
    help|-h|--help)
        echo "usage: darkos-tool-groups [list | install <group> [<group> ...]]"
        ;;
    *)     interactive_pick ;;
esac
