#!/usr/bin/env bash
# Launch Calamares from the live Hyprland session without losing the
# Wayland socket and session bus when privileges are raised.

set -euo pipefail

if [[ ! -d /run/archiso && "${DARKOS_INSTALLER_ALLOW_NONLIVE:-0}" != 1 ]]; then
    printf '%s\n' 'The DarkOS installer is only available from the live ISO.' >&2
    exit 1
fi

if ! command -v calamares >/dev/null 2>&1; then
    printf '%s\n' 'Calamares is not installed.' >&2
    exit 127
fi

session_uid="$(id -u)"
if [[ $EUID -eq 0 && -n "${SUDO_UID:-}" ]]; then
    session_uid="$SUDO_UID"
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${session_uid}}"
if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
    printf 'Wayland runtime directory is missing: %s\n' "$XDG_RUNTIME_DIR" >&2
    exit 1
fi

# Calamares' Qt Quick UI is more reliable with software rendering in VMs.
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
elif [[ -n "${DISPLAY:-}" ]]; then
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
else
    printf '%s\n' 'No Wayland or X11 display is available for Calamares.' >&2
    exit 1
fi

if [[ $EUID -eq 0 ]]; then
    exec calamares "$@"
fi

if ! command -v sudo >/dev/null 2>&1; then
    printf '%s\n' 'sudo is required to start the installer.' >&2
    exit 127
fi

# Preserve only the display/session values Calamares needs. Passing an
# explicit list avoids sudo -E's broad environment preservation.
preserve_env='XDG_RUNTIME_DIR,WAYLAND_DISPLAY,DISPLAY,XAUTHORITY,DBUS_SESSION_BUS_ADDRESS,QT_QPA_PLATFORM,QT_QUICK_BACKEND,XDG_CURRENT_DESKTOP,XDG_SESSION_TYPE'
exec sudo --preserve-env="$preserve_env" -- calamares "$@"
