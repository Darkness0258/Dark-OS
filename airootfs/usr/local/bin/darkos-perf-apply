#!/usr/bin/env bash
# darkos-perf-apply -- write ~/.config/hypr/conf.d/perf-auto.conf for the
# chosen desktop-effects profile, then (unless --no-reload) reload Hyprland.
#
# Profiles (settings.json key "effects"):
#   lite  no blur, no shadows, no animations, square corners, opaque windows
#   full  everything hyprland.conf defines (blur, shadows, animations,
#         rounded corners, translucent app windows)
#   auto  (default) lite inside a VM, full on real hardware
#
# Why "lite" goes further than blur/shadow/animations: on a software
# renderer (llvmpipe) every translucent window and every rounded corner is
# still extra per-pixel compositing work, so lite removes those too.
set -euo pipefail

reload=1
[[ "${1:-}" == "--no-reload" ]] && reload=0

settings="${XDG_CONFIG_HOME:-${HOME:-/root}/.config}/darkos/settings.json"
conf_dir="${HOME:-/root}/.config/hypr/conf.d"
conf="$conf_dir/perf-auto.conf"

read_setting() {  # read_setting KEY ALLOWED_REGEX DEFAULT
    local key="$1" allowed="$2" default="$3" value=""
    if [[ -r "$settings" ]]; then
        value="$(grep -oE "\"$key\"[[:space:]]*:[[:space:]]*\"[a-z]+\"" "$settings" 2>/dev/null \
            | head -n1 | sed -E 's/.*:[[:space:]]*"([a-z]+)"/\1/')" || true
    fi
    if [[ "$value" =~ ^($allowed)$ ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$default"
    fi
}

is_vm() {
    if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
        return 0
    fi
    [[ -f /sys/class/dmi/id/sys_vendor ]] \
        && grep -qiE 'vmware|virtualbox|qemu|kvm' /sys/class/dmi/id/sys_vendor 2>/dev/null
}

profile="$(read_setting effects 'auto|lite|full' auto)"
if [[ "$profile" == auto ]]; then
    if is_vm; then profile=lite; else profile=full; fi
fi

mkdir -p "$conf_dir"
tmp="$(mktemp "$conf_dir/.perf-auto.XXXXXX")"
case "$profile" in
    lite)
        cat > "$tmp" <<'LITE'
# Generated by darkos-perf-apply (profile: lite). Do not hand-edit.
decoration:blur:enabled = false
decoration:shadow:enabled = false
decoration:rounding = 0
decoration:dim_inactive = false
animations:enabled = false
# Later rules win: make every window fully opaque (no alpha blending).
windowrule = opacity 1.0 1.0, match:class ^(.*)$
LITE
        ;;
    *)
        printf '# Generated by darkos-perf-apply (profile: full). Do not hand-edit.\n' > "$tmp"
        ;;
esac
chmod 0644 "$tmp"
mv -f "$tmp" "$conf"
printf 'darkos-perf-apply: profile=%s\n' "$profile"

if [[ "$reload" == 1 ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
fi
