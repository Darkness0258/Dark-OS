#
# DarkOS branding for Calamares

---
componentName: darkos

### WELCOME / OVERALL WORDING
welcomeStyleCalamares:   false
welcomeExpandingLogo:   true

### WINDOW CONFIGURATION
windowExpanding:    normal
windowSize: 960px,600px
windowPlacement: center

### PANELS CONFIGURATION
sidebar: widget
navigation: widget

### STRINGS, IMAGES AND COLORS
strings:
    productName:         "DarkOS"
    shortProductName:    DarkOS
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "DarkOS 1.0"
    shortVersionedName:  DarkOS 1.0
    bootloaderEntryName: DarkOS
    productUrl:          https://darkos.dev
    supportUrl:          https://darkos.dev/support
    knownIssuesUrl:      https://darkos.dev/issues
    releaseNotesUrl:     https://darkos.dev/releases
    donateUrl:           https://kde.org/community/donations/index.php

images:
    productIcon:         "icons/darkos.png"
    productLogo:         "icons/darkos.png"
    productWelcome:      "icons/darkos.png"

style:
   SidebarBackground:        "#000000"
   SidebarText:              "#e2e8f0"
   SidebarTextCurrent:       "#00e5ff"
   SidebarBackgroundCurrent: "#1a1a2e"

### SLIDESHOW
slideshow:               "show.qml"
slideshowAPI: 2

uploadServer :
    type :    "none"
