[Desktop Entry]
Type=Application
Name=Gallery
Comment=DarkOS image gallery and viewer
TryExec=/usr/local/bin/darkos-sandbox-launch.py
Exec=/usr/local/bin/darkos-sandbox-launch.py gallery -- /usr/local/bin/darkos-gallery.py
Icon=image-viewer
Categories=Graphics;Viewer;
StartupNotify=true
StartupWMClass=darkos-gallery
Terminal=false
